<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LabRegistry.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LabRegistry.UI.Views.EquipmentView"
        Title="Gestión de Equipos de Laboratorio"
        Width="650" Height="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15" RowDefinitions="Auto, Auto, *, Auto">
        <TextBlock Grid.Row="0" Text="Catálogo de Equipos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#F4F4F4" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto">
                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Nombre:"/>
                        <TextBox Name="NameTextBox" PlaceholderText="Ej. Multímetro Digital"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Categoría:"/>
                        <TextBox Name="CategoryTextBox" PlaceholderText="Ej. Medición"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="5">
                    <TextBlock Text="Estado:"/>
                    <ComboBox Name="StatusComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Name="EquipmentsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  x:DataType="models:Equipment"
                  SelectionChanged="EquipmentsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="150" />
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusEquipment}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Nuevo" Click="NewButton_Click"/>
            <Button Content="Guardar" Click="SaveButton_Click" Classes="accent"/>
            <Button Content="Eliminar" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>