<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LabRegistry.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LabRegistry.UI.Views.StudentView"
        Title="Gestión de Estudiantes"
        Width="650" Height="450"
        WindowStartupLocation="CenterScreen">

        <Grid Margin="15" RowDefinitions="Auto, Auto, *, Auto">
        <TextBlock Grid.Row="0" Text="Registro de Estudiantes" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#F4F4F4" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Correo Institucional:"/>
                    <TextBox Name="EmailTextBox" PlaceholderText="estudiante@universidad.edu"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Nombre:"/>
                    <TextBox Name="NameTextBox" PlaceholderText="Ej. Juan"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <TextBlock Text="Apellido:"/>
                    <TextBox Name="LastNameTextBox" PlaceholderText="Ej. Pérez"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Name="StudentsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  x:DataType="models:Student"
                  SelectionChanged="StudentsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="100" />
                <DataGridTextColumn Header="Apellido" Binding="{Binding LastName}" Width="100" />
                <DataGridTextColumn Header="Correo Institucional" Binding="{Binding Email}" Width="250" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Nuevo" Click="NewButton_Click" Classes="accent"/>
            <Button Content="Guardar" Click="SaveButton_Click"/>
            <Button Content="Eliminar" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
